# Copier ce fichier en .env sur le serveur, puis remplacer les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub ni dans la conversation.

ENVIRONNEMENT=production

# Mot de passe de la base : une longue suite de caractères aléatoires, propre à Jeff.
POSTGRES_PASSWORD=A_REMPLACER

# Port local de l'API sur le serveur (8010 est déjà pris par un autre projet).
JEFF_PORT=8020

# Page d'essai de la bulle web (/essai). Accessible uniquement par tunnel SSH tant qu'il n'y a pas de HTTPS.
ESSAI_ACTIF=true

# Envoi des emails (rappels, codes de confirmation) par le SMTP de Brevo.
# Identifiant et clé SMTP : compte Brevo > SMTP & API > onglet SMTP. La clé ne quitte jamais ce fichier.
SMTP_HOTE=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_UTILISATEUR=A_REMPLACER
SMTP_MOT_DE_PASSE=A_REMPLACER
# Adresse d'expédition sur votre domaine, validé chez Brevo (lignes DNS SPF et DKIM).
EMAIL_EXPEDITEUR=jeff@VOTRE_DOMAINE
